# Publication allowlist. Unknown root files stay local until deliberately reviewed.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/app.py
!/scaleflow/
!/tests/
!/requirements.txt
!/.streamlit/
!/data/
!/prepared/
!/templates/
!/scenarios.json
!/generate_data.py
!/prepare_examples.py
!/launch.ps1
!/docs/
!/verification/

/.streamlit/*
!/.streamlit/config.toml

/docs/*
!/docs/screenshots/
/verification/*
!/verification/ollama_status.json
/data/*
!/data/DATA_DESIGN.md
!/data/manifest.json
!/data/normal/
!/data/demand/
!/data/disruption/
/data/*/*
!/data/*/cases.json
!/data/*/cases.csv
!/data/*/stage_events.json
!/data/*/stage_events.csv
!/data/*/snapshot.json

# Shared exclusions; example configuration is intentionally public.
**/__pycache__/
*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.coverage
**/htmlcov/
**/.venv/
**/venv/
**/env/
**/node_modules/
**/.env
**/.env.*
!/.env.example
**/secrets.toml
**/*credentials*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.db
**/*.db-*
**/*.sqlite
**/*.sqlite-*
**/*.sqlite3
**/*.sqlite3-*
**/*.log
**/*.zip
**/*.exe
**/*.msi
**/*.tmp
**/*.bak
**/*~
**/.DS_Store
**/Thumbs.db
**/.idea/
**/.vscode/
**/.agents/
**/.codex/
